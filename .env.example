# Copiez ce fichier en `.env` (fait automatiquement par `npm run setup`).
# `.env` n'est jamais versionné.

# --- Base de données (docker-compose : service "db") ---
POSTGRES_USER=mira
POSTGRES_PASSWORD=mira
POSTGRES_DB=mira
DATABASE_URL="postgresql://mira:mira@localhost:5432/mira?schema=public"

# --- Authentification ---
# "dev-stub" : l'utilisateur courant est le compte de démonstration (aucun mot de passe).
# À remplacer par une vraie authentification dans la phase 09 (RGPD & sécurité).
AUTH_MODE=dev-stub
DEV_USER_EMAIL=demo.dupont@example.com
